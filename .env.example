# ============================================
# SAE - Sistema de Administración Educativa
# Configuración de Variables de Entorno
# ============================================

# ============================================
# CRÍTICO: Secretos y Autenticación
# CAMBIAR EN PRODUCCIÓN (Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
# ============================================
JWT_SECRET=genera_un_secreto_aleatorio_muy_seguro_aqui_minimo_32_caracteres
HMAC_SECRET=otro_secreto_aleatorio_muy_seguro_aqui_minimo_32_caracteres
UPDATE_SECRET=secreto_para_actualizaciones_del_sistema_minimo_32_caracteres

# ============================================
# Servidor Express
# ============================================
# Puerto en el que se ejecuta el backend
PORT=5000

# Entorno de ejecución: development, production, test
NODE_ENV=development

# ============================================
# Base de Datos (SQLite)
# ============================================
# DATABASE_URL no es obligatorio - el sistema usa SQLite automáticamente
# Si lo definis, usa un path absoluto o relativo a la raíz del proyecto
# Ejemplos: file:./prisma/dev.db  o  file:/absolute/path/to/dev.db
# DATABASE_URL=file:./prisma/dev.db

# ============================================
# Socket.IO - WebSocket Configuration
# ============================================
# PRODUCCIÓN WEB SOLAMENTE: Dominios permitidos para Socket.IO (separados por coma)
# En desarrollo: auto-configurado para localhost
# En Electron: auto-configurado para conexiones locales
# Ejemplo: https://app.dominio.com,https://admin.dominio.com
ALLOWED_ORIGINS=

# ============================================
# Electron - Rutas de Datos (Automáticas)
# ============================================
# NO EDITAR - Se establece automáticamente en el proceso Electron
# RESOURCES_PATH=indicará que se ejecuta dentro de un bundle Electron
# SAE_DATA_DIR=ubicación en %APPDATA%\SAE (Windows) o ~/.sae (Linux/Mac)
# ELECTRON_RUN_AS_NODE=indicará que Node.js se ejecuta bajo Electron

# ============================================
# Prisma & Base de Datos (Desarrollo)
# ============================================
# Ubicación de schema.prisma (normalmente no cambiar)
PRISMA_SCHEMA_PATH=./prisma/schema.prisma

# ============================================
# Notas
# ============================================
# 1. Todos los secretos deben tener mínimo 32 caracteres en producción
# 2. Para generar secretos seguros: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# 3. En Electron, los datos se almacenan en: %APPDATA%\SAE (Windows)
# 4. No incluyas este archivo .env en versión control de producción
# 5. DATABASE_URL es automático en SQLite (no requiere configuración)
